# Kailash Global Impex — Environment Configuration Sample
# Copy to .env for local overrides (optional) or set as Environment Variables in Render Dashboard

# --- Django Core Configuration ---
DJANGO_SECRET_KEY=your-production-secure-random-secret-key-at-least-50-chars
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=kailashglobalimpex.com,www.kailashglobalimpex.com,your-app-name.onrender.com
CSRF_TRUSTED_ORIGINS=https://kailashglobalimpex.com,https://www.kailashglobalimpex.com,https://your-app-name.onrender.com

# --- Database Configuration ---
# In production on Render, link the managed PostgreSQL database and set DATABASE_URL
# Example: postgres://kgi_user:password@dpg-xxxxx.render.com/kgi_db
# In local development, leave DATABASE_URL empty to automatically use SQLite (db.sqlite3)
DATABASE_URL=

# --- SSL & Security (Enabled when DJANGO_DEBUG=False) ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- Email Delivery (SMTP) ---
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=kailashglobalimpex@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-smtp-password
COMPANY_NOTIFICATION_EMAIL=kailashglobalimpex@gmail.com

# --- Initial Seed / Admin Setup (Used by python manage.py seed_kgi_data) ---
KGI_ADMIN_USER=admin
KGI_ADMIN_EMAIL=kailashglobalimpex@gmail.com
KGI_ADMIN_PASS=Kailash@2026Export
